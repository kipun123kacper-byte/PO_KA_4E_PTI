<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotatkiMobilne.MainPage"
             Title="Moje notatki">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Moje notatki"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1F2937" />
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">

                <Entry x:Name="NoteEntry"
                       Grid.Column="0"
                       Placeholder="Nowy element"
                       FontSize="16" />

                <Button x:Name="AddButton"
                        Grid.Column="1"
                        Text="DODAJ"
                        BackgroundColor="#DC143C"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnAddNoteClicked" />
            </Grid>
            <CollectionView x:Name="NotesListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding .}"
                                   FontSize="16"
                                   Padding="12, 10" />
                            <BoxView HeightRequest="1"
                                     Color="#DC143C"
                                     HorizontalOptions="FillAndExpand" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>